# Optional. Pin the end of the synthetic data window for reproducible output.
# Unset, data/generate.py uses the end of last month so the demo stays current.
CRP_DATA_END=2026-07-31

# Fake ad platform API (adsapi/). The key is required; it won't start without one.
# Deployed, use a long random value:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADSAPI_KEY=local-dev-key-change-me
ADSAPI_URL=http://127.0.0.1:8000
# Share of requests that fail on purpose (0 to 1), so retries get exercised.
FAULT_RATE=0.1
RATE_LIMIT_PER_MIN=60

# Local Postgres from docker compose. Local only; Neon gets real credentials
# at deploy time.
POSTGRES_PASSWORD=postgres-local-only
DATABASE_URL=postgresql://postgres:postgres-local-only@127.0.0.1:5432/postgres
TEST_DATABASE_URL=postgresql://postgres:postgres-local-only@127.0.0.1:5432/crp_test

# Email. These point at Mailpit from docker compose; real SMTP is the same
# settings with SMTP_TLS on.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_TLS=off
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=reports@example.com
# Sends every report to this one inbox instead of the addresses in clients.toml.
DEMO_RECIPIENT=
DAILY_SEND_CAP=10

# Run summary. Leave empty to skip it. The URL is a secret.
SLACK_WEBHOOK_URL=
